# Setup git for Gemini
git config --global user.email jonathan.gopel@gemini.com

# Manage packages
CMAKE_VERSION=3.21.5
FZF_VERSION=0.29.0
GIT_VERSION=2.35.1
TMUX_VERSION=3.2a

setup_cmake_package() {
  pushd ~/packages/cmake
  git checkout v${CMAKE_VERSION}
  ./bootstrap
  make -j $(nproc)
  sudo make install
  popd
}

setup_fzf_package() {
  pushd ~/packages/fzf
  git checkout ${FZF_VERSION}
  ./install --all
  popd
}

setup_git_package() {
  sudo apt install --assume-yes dh-autoreconf libcurl4-gnutls-dev libexpat1-dev \
                                gettext libz-dev libssl-dev asciidoc xmlto \
                                docbook2x
  pushd ~/packages/git
  git checkout v${GIT_VERSION}
  make configure
  ./configure --prefix=/usr
  make all doc info -j $(nproc)
  sudo make install install-doc install-html install-info
  popd
}

setup_tmux_package() {
  sudo apt install --assume-yes libevent-dev bison
  pushd ~/packages/tmux/
  git checkout ${TMUX_VERSION}
  sh autogen.sh
  ./configure
  make -j $(nproc)
  sudo make install
  popd
}

setup_vim_package() {
  sudo apt install --assume-yes libncurses5-dev libgtk2.0-dev libatk1.0-dev \
                                libcairo2-dev libx11-dev libxpm-dev libxt-dev
  pushd ~/packages/vim
  git pull
  ./configure --with-features=huge --enable-python3interp
  make -j $(nproc)
  sudo make install
  popd
}

setup_packages() {
  set -euo pipefail
  setup_git_package
  setup_tmux_package
  setup_vim_package
  setup_fzf_package
  setup_cmake_package
  set +euo pipefail
}

update_ssl_certs() {
  sudo update-ca-certificates --fresh
  export SSL_CERT_DIR=/etc/ssl/certs
}

source ~/packages/git/contrib/completion/git-completion.bash

# gemcli
export GEMINI_REPO_HOME=$HOME/gemini
source $GEMINI_REPO_HOME/raptor-tools/rap-cli/setup
