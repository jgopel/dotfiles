#!/bin/bash

set -euo pipefail

ROLE_INFO="$(aws sts assume-role --role-arn "arn:aws:iam::143586981971:role/$1" --role-session-name ManuallyAssumedRole)"

AWS_ACCESS_KEY_ID="$(echo "$ROLE_INFO" | jq --raw-output '.Credentials.AccessKeyId')"
AWS_SECRET_ACCESS_KEY="$(echo "$ROLE_INFO" | jq --raw-output '.Credentials.SecretAccessKey')"
AWS_SESSION_TOKEN="$(echo "$ROLE_INFO" | jq --raw-output '.Credentials.SessionToken')"

export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN

echo 'Assumed role:'
aws sts get-caller-identity
