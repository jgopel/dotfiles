Subject: [PATCH] net: atlantic: TEST ONLY hook to remove the NIC during resume

Local reproduction for the XPS dock resume hang. Not for upstream.

The suspected bug: suspend stops an administratively-up interface and
disables its NAPI instances. If the PCI device is removed before normal
resume restarts it, aq_pci_remove() -> unregister_netdev() ->
aq_ndev_close() -> aq_nic_stop() -> aq_vec_stop() disables NAPI a second
time. napi_disable() then waits forever while the removal task holds the
PCI device mutex and RTNL, so the PCI device's normal resume and wiphy
resume block behind it.

Writing Y to /sys/module/atlantic/parameters/repro_remove_on_resume arms
a one-shot hook. On the next system resume, resume_early (which does not
hold the device lock) queues pci_stop_and_remove_bus_device_locked() on
system_dfl_long_wq, the same core removal pciehp uses, and waits until
the removal reaches aq_pci_remove() with the device mutex held. The later
normal resume of the device then blocks in device_lock() with the DPM
watchdog armed.

Also log IFF_UP/running at suspend, resume_early and removal, and dump
the stack when aq_vec_stop() finds NAPI already disabled, so a run shows
whether the first stop happened and where the second one came from.

---
diff -ru a/drivers/net/ethernet/aquantia/atlantic/aq_pci_func.c b/drivers/net/ethernet/aquantia/atlantic/aq_pci_func.c
--- a/drivers/net/ethernet/aquantia/atlantic/aq_pci_func.c	2026-11-06 16:00:13.624354696 -0700
+++ b/drivers/net/ethernet/aquantia/atlantic/aq_pci_func.c	2026-11-06 16:05:54.390754286 -0700
@@ -9,6 +9,7 @@

 #include <linux/interrupt.h>
 #include <linux/module.h>
+#include <linux/workqueue.h>

 #include "aq_main.h"
 #include "aq_nic.h"
@@ -22,6 +23,35 @@
 #include "aq_drvinfo.h"
 #include "aq_macsec.h"

+#ifdef CONFIG_PM
+/*
+ * TEST ONLY: reproduce PCI removal racing system resume. When armed, the next
+ * resume_early callback starts a normal PCI removal of this device on a
+ * workqueue, then waits until that removal holds the device lock in
+ * aq_pci_remove(), so the later normal resume waits behind it.
+ */
+static bool aq_repro_remove;
+module_param_named(repro_remove_on_resume, aq_repro_remove, bool, 0644);
+MODULE_PARM_DESC(repro_remove_on_resume,
+		 "TEST ONLY: remove the device during the next system resume (one-shot)");
+
+static struct pci_dev *aq_repro_pdev;
+static DECLARE_COMPLETION(aq_repro_in_remove);
+
+static void aq_repro_remove_fn(struct work_struct *work)
+{
+	struct pci_dev *pdev = aq_repro_pdev;
+
+	pci_warn(pdev, "repro: removal starting in %s:%d\n", current->comm,
+		 task_pid_nr(current));
+	pci_stop_and_remove_bus_device_locked(pdev);
+	pr_warn("atlantic: repro: removal finished\n");
+	WRITE_ONCE(aq_repro_pdev, NULL);
+	pci_dev_put(pdev);
+}
+static DECLARE_WORK(aq_repro_work, aq_repro_remove_fn);
+#endif
+
 static const struct pci_device_id aq_pci_tbl[] = {
 	{ PCI_VDEVICE(AQUANTIA, AQ_DEVICE_ID_0001), },
 	{ PCI_VDEVICE(AQUANTIA, AQ_DEVICE_ID_D100), },
@@ -343,6 +373,17 @@
 {
 	struct aq_nic_s *self = pci_get_drvdata(pdev);

+#ifdef CONFIG_PM
+	if (pdev == READ_ONCE(aq_repro_pdev)) {
+		if (self->ndev)
+			netdev_warn(self->ndev, "repro: aq_pci_remove holds device lock: running=%d IFF_UP=%d present=%d\n",
+				    netif_running(self->ndev),
+				    !!(self->ndev->flags & IFF_UP),
+				    netif_device_present(self->ndev));
+		complete(&aq_repro_in_remove);
+	}
+#endif
+
 	if (self->ndev) {
 		aq_clear_rxnfc_all_rules(self);
 		if (self->ndev->reg_state == NETREG_REGISTERED)
@@ -384,6 +425,9 @@

 	rtnl_lock();

+	netdev_info(nic->ndev, "repro: suspend: running=%d IFF_UP=%d (running means NAPI is disabled here)\n",
+		    netif_running(nic->ndev), !!(nic->ndev->flags & IFF_UP));
+
 	nic->power_state = AQ_HW_POWER_STATE_D3;
 	netif_device_detach(nic->ndev);
 	netif_tx_stop_all_queues(nic->ndev);
@@ -454,7 +498,37 @@
 	return atl_resume_common(dev);
 }

+static int aq_pm_resume_early(struct device *dev)
+{
+	struct pci_dev *pdev = to_pci_dev(dev);
+	struct aq_nic_s *nic = pci_get_drvdata(pdev);
+
+	if (!READ_ONCE(aq_repro_remove))
+		return 0;
+	WRITE_ONCE(aq_repro_remove, false);
+	if (READ_ONCE(aq_repro_pdev)) {
+		dev_err(dev, "repro: previous removal still in progress; not arming\n");
+		return 0;
+	}
+
+	netdev_warn(nic->ndev, "repro: resume_early: running=%d IFF_UP=%d present=%d; starting removal\n",
+		    netif_running(nic->ndev), !!(nic->ndev->flags & IFF_UP),
+		    netif_device_present(nic->ndev));
+
+	/* nic may be freed once removal runs; only use static state below. */
+	reinit_completion(&aq_repro_in_remove);
+	aq_repro_pdev = pci_dev_get(pdev);
+	queue_work(system_dfl_long_wq, &aq_repro_work);
+	if (!wait_for_completion_timeout(&aq_repro_in_remove, 10 * HZ))
+		dev_err(dev, "repro: removal did not reach aq_pci_remove within 10s\n");
+	else
+		dev_warn(dev, "repro: removal holds the device lock; continuing resume\n");
+
+	return 0;
+}
+
 static const struct dev_pm_ops aq_pm_ops = {
+	.resume_early = aq_pm_resume_early,
 	.suspend = aq_pm_suspend_poweroff,
 	.poweroff = aq_pm_suspend_poweroff,
 	.freeze = aq_pm_freeze,
diff -ru a/drivers/net/ethernet/aquantia/atlantic/aq_vec.c b/drivers/net/ethernet/aquantia/atlantic/aq_vec.c
--- a/drivers/net/ethernet/aquantia/atlantic/aq_vec.c	2026-11-06 16:00:13.635354775 -0700
+++ b/drivers/net/ethernet/aquantia/atlantic/aq_vec.c	2026-11-06 16:00:35.515512826 -0700
@@ -251,6 +251,7 @@
 void aq_vec_stop(struct aq_vec_s *self)
 {
 	struct aq_ring_s *ring = NULL;
+	unsigned long napi_state;
 	unsigned int i = 0U;

 	for (i = 0U; self->tx_rings > i; ++i) {
@@ -262,6 +263,14 @@
 						 &ring[AQ_VEC_RX_ID]);
 	}

+	/* TEST ONLY: report a repeated disable before it blocks forever. */
+	napi_state = READ_ONCE(self->napi.state);
+	if ((napi_state & NAPIF_STATE_SCHED) && (napi_state & NAPIF_STATE_NPSVC)) {
+		pr_warn("atlantic: repro: vec%u NAPI already disabled (state=%#lx, tx_rings=%u); napi_disable will not return\n",
+			self->aq_ring_param.vec_idx, napi_state, self->tx_rings);
+		dump_stack();
+	}
+
 	napi_disable(&self->napi);
 }
