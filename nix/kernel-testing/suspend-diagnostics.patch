 		goto Devices_early_resume;

+	suspend_diag("devices-noirq begin\n");
 	error = dpm_suspend_noirq(PMSG_SUSPEND);
+	suspend_diag("devices-noirq end error=%d\n", error);
 	if (error) {
 		pr_err("noirq suspend of devices failed\n");
 		goto Platform_early_resume;
 	}
+	suspend_diag("platform-prepare-noirq begin\n");
 	error = platform_suspend_prepare_noirq(state);
+	suspend_diag("platform-prepare-noirq end error=%d\n", error);
 	if (error)
 		goto Platform_wake;

-	if (suspend_test(TEST_PLATFORM))
+	if (suspend_test(TEST_PLATFORM)) {
+		suspend_diag("platform test: skipping sleep\n");
 		goto Platform_wake;
+	}

 	if (state == PM_SUSPEND_TO_IDLE) {
 		s2idle_loop();
@@ -483,17 +552,26 @@
 	pm_sleep_enable_secondary_cpus();

  Platform_wake:
+	suspend_diag("platform-resume-noirq begin\n");
 	platform_resume_noirq(state);
+	suspend_diag("platform-resume-noirq end; devices-resume-noirq begin\n");
 	dpm_resume_noirq(PMSG_RESUME);
+	suspend_diag("devices-resume-noirq end\n");

  Platform_early_resume:
+	suspend_diag("platform-resume-early begin\n");
 	platform_resume_early(state);
+	suspend_diag("platform-resume-early end\n");

  Devices_early_resume:
+	suspend_diag("devices-resume-early begin\n");
 	dpm_resume_early(PMSG_RESUME);
+	suspend_diag("devices-resume-early end\n");

  Platform_finish:
