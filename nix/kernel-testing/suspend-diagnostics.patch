@@ -622,6 +722,7 @@
 	pm_pr_dbg("Finishing wakeup.\n");
 	suspend_finish();
  Unlock:
+	suspend_diag("end error=%d\n", error);
 	mutex_unlock(&system_transition_mutex);
 	return error;
 }
--- a/kernel/time/tick-common.c
