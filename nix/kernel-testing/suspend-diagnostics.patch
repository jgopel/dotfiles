Subject: [PATCH] PM: add opt-in XPS suspend phase diagnostics

Local diagnostic patch, enabled by pm_debug_messages. Record suspend phase
boundaries, PM notifier callbacks, rollback, and the first s2idle all-CPU
barrier and exit. Existing pm_print_times supplies device callback details.
Sample s2idle loop iterations to avoid an unbounded spurious-wakeup log.

The idle-barrier messages use printk_deferred so they do not invoke console
drivers under tick_freeze_lock. This barrier does not prove hardware S0ix
residency. Printk records are not durable while journald is frozen.

---
diff --git a/include/linux/suspend.h b/include/linux/suspend.h
--- a/include/linux/suspend.h
+++ b/include/linux/suspend.h
@@ -146,6 +146,7 @@
 extern suspend_state_t pm_suspend_target_state;
 extern suspend_state_t mem_sleep_current;
 extern suspend_state_t mem_sleep_default;
+void pm_debug_s2idle_barrier(bool entering);

 /**
  * suspend_set_ops - set platform dependent suspend operations
@@ -449,6 +450,7 @@
 /* kernel/power/main.c */
 extern int register_pm_notifier(struct notifier_block *nb);
 extern int unregister_pm_notifier(struct notifier_block *nb);
+bool pm_debug_notifier_chain(struct notifier_block **head);
 extern void ksys_sync_helper(void);
 extern void pm_report_hw_sleep_time(u64 t);
 extern void pm_report_max_hw_sleep(u64 t);
@@ -498,6 +500,11 @@
 	return 0;
 }

+static inline bool pm_debug_notifier_chain(struct notifier_block **head)
+{
+	return false;
+}
+
 static inline void pm_report_hw_sleep_time(u64 t) {};
 static inline void pm_report_max_hw_sleep(u64 t) {};

