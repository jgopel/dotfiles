 	platform_resume_finish(state);
+	suspend_diag("platform-finish end\n");
 	return error;
 }

@@ -514,13 +592,18 @@
 	if (state == PM_SUSPEND_TO_IDLE)
 		pm_set_suspend_no_platform();

+	suspend_diag("platform-begin begin\n");
 	error = platform_suspend_begin(state);
+	suspend_diag("platform-begin end error=%d\n", error);
 	if (error)
 		goto Close;

+	suspend_diag("console-suspend begin\n");
 	console_suspend_all();
+	suspend_diag("console-suspend end; devices-suspend begin\n");
 	suspend_test_start();
 	error = dpm_suspend_start(PMSG_SUSPEND);
+	suspend_diag("devices-suspend end error=%d\n", error);
 	if (error) {
 		pr_err("Some devices failed to suspend, or early wake event detected\n");
 		goto Recover_platform;
@@ -535,19 +618,27 @@

  Resume_devices:
 	suspend_test_start();
+	suspend_diag("devices-resume begin\n");
 	dpm_resume_end(PMSG_RESUME);
+	suspend_diag("devices-resume end\n");
 	suspend_test_finish("resume devices");
 	trace_suspend_resume(TPS("console_resume_all"), state, true);
+	suspend_diag("console-resume begin\n");
 	console_resume_all();
+	suspend_diag("console-resume end\n");
