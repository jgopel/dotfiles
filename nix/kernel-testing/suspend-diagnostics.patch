@@ -68,6 +69,7 @@
 {
 	int ret = NOTIFY_DONE;
 	struct notifier_block *nb, *next_nb;
+	bool debug_pm = pm_debug_notifier_chain(nl);

 	nb = rcu_dereference_raw(*nl);

@@ -82,7 +84,13 @@
 		}
 #endif
 		trace_notifier_run((void *)nb->notifier_call);
+		if (debug_pm)
+			pr_notice("PM: diag notifier=%ps event=%lu begin\n",
+				  nb->notifier_call, val);
 		ret = nb->notifier_call(nb, val, v);
+		if (debug_pm)
