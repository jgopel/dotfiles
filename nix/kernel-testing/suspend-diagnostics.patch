  Close:
+	suspend_diag("platform-end begin\n");
 	platform_resume_end(state);
+	suspend_diag("platform-end end error=%d\n", error);
 	pm_suspend_target_state = PM_SUSPEND_ON;
 	return error;

  Recover_platform:
+	suspend_diag("platform-recover begin error=%d\n", error);
 	platform_recover(state);
+	suspend_diag("platform-recover end\n");
 	goto Resume_devices;
 }

@@ -559,10 +650,15 @@
  */
 static void suspend_finish(void)
 {
+	suspend_diag("tasks-thaw begin\n");
 	suspend_thaw_processes();
+	suspend_diag("tasks-thaw end; filesystems-thaw begin\n");
 	filesystems_thaw();
+	suspend_diag("filesystems-thaw end; post-notifiers begin\n");
