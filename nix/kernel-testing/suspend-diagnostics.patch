 {
 	return blocking_notifier_chain_register(&pm_chain_head, nb);
--- a/kernel/power/suspend.c
+++ b/kernel/power/suspend.c
@@ -20,6 +20,7 @@
 #include <linux/io.h>
 #include <linux/kernel.h>
 #include <linux/list.h>
+#include <linux/log2.h>
 #include <linux/mm.h>
 #include <linux/slab.h>
 #include <linux/export.h>
@@ -62,6 +63,30 @@
 enum s2idle_states __read_mostly s2idle_state;
 static DEFINE_RAW_SPINLOCK(s2idle_lock);

+/* Serialized by system_transition_mutex; notice level keeps photos readable. */
+static unsigned long suspend_diag_cycle;
+static bool s2idle_diag_seen[2];
+
+#define suspend_diag(fmt, ...) do { \
+	if (pm_debug_messages_on) \
+		pr_notice("diag cycle=%lu " fmt, suspend_diag_cycle, ##__VA_ARGS__); \
+} while (0)
+
+/* Called under tick_freeze_lock with interrupts disabled. */
+void pm_debug_s2idle_barrier(bool entering)
+{
+	if (!pm_debug_messages_on || pm_suspend_target_state != PM_SUSPEND_TO_IDLE ||
+	    s2idle_diag_seen[entering])
+		return;
+
+	s2idle_diag_seen[entering] = true;
+	/* Never invoke a console driver from inside the idle barrier. */
+	printk_deferred(KERN_NOTICE "PM: diag cycle=%lu first %s cpu=%u\n",
+			suspend_diag_cycle,
+			entering ? "all-CPU idle barrier" : "idle exit",
+			smp_processor_id());
+}
+
 /**
  * pm_suspend_default_s2idle - Check if suspend-to-idle is the default suspend.
  *
@@ -86,6 +111,8 @@
 static void s2idle_begin(void)
 {
 	s2idle_state = S2IDLE_STATE_NONE;
+	s2idle_diag_seen[0] = false;
+	s2idle_diag_seen[1] = false;
 }

 static void s2idle_enter(void)
@@ -132,7 +159,11 @@

 static void s2idle_loop(void)
 {
+	unsigned long iterations = 0;
+	bool report;
+
 	pm_pr_dbg("suspend-to-idle\n");
+	suspend_diag("s2idle-loop begin\n");

 	/*
 	 * Suspend-to-idle equals:
@@ -144,19 +175,34 @@
 	 * to avoid them upfront.
 	 */
 	for (;;) {
+		iterations++;
+		/* Log early iterations and powers of two, not every spurious wake. */
+		report = iterations <= 4 || is_power_of_2(iterations);
+		if (report)
+			suspend_diag("s2idle iteration=%lu wake-check begin\n", iterations);
 		if (s2idle_ops && s2idle_ops->wake) {
-			if (s2idle_ops->wake())
+			if (s2idle_ops->wake()) {
+				suspend_diag("platform wake accepted irq=%u\n", pm_wakeup_irq());
 				break;
+			}
 		} else if (pm_wakeup_pending()) {
+			suspend_diag("wakeup pending irq=%u\n", pm_wakeup_irq());
 			break;
 		}

+		if (report)
+			suspend_diag("s2idle iteration=%lu platform-check begin\n", iterations);
 		if (s2idle_ops && s2idle_ops->check)
 			s2idle_ops->check();

+		if (report)
+			suspend_diag("s2idle iteration=%lu idle-enter begin\n", iterations);
 		s2idle_enter();
+		if (report)
+			suspend_diag("s2idle iteration=%lu idle-enter end\n", iterations);
 	}

+	suspend_diag("s2idle-loop end iterations=%lu\n", iterations);
 	pm_pr_dbg("resume from suspend-to-idle\n");
 }

@@ -376,24 +422,35 @@
 	if (!sleep_state_supported(state))
 		return -EPERM;

+	suspend_diag("console-prepare begin\n");
 	pm_prepare_console();
+	suspend_diag("console-prepare end; prepare-notifiers begin\n");

 	error = pm_notifier_call_chain_robust(PM_SUSPEND_PREPARE, PM_POST_SUSPEND);
+	suspend_diag("prepare-notifiers end error=%d\n", error);
 	if (error)
 		goto Restore;

+	suspend_diag("filesystems-freeze begin enabled=%d\n", filesystem_freeze_enabled);
 	filesystems_freeze(filesystem_freeze_enabled);
+	suspend_diag("filesystems-freeze end; tasks-freeze begin\n");
 	trace_suspend_resume(TPS("freeze_processes"), 0, true);
 	error = suspend_freeze_processes();
 	trace_suspend_resume(TPS("freeze_processes"), 0, false);
+	suspend_diag("tasks-freeze end error=%d\n", error);
 	if (!error)
 		return 0;

 	dpm_save_failed_step(SUSPEND_FREEZE);
+	suspend_diag("freeze-failure rollback: filesystems-thaw begin\n");
 	filesystems_thaw();
+	suspend_diag("filesystems-thaw end; rollback-notifiers begin\n");
 	pm_notifier_call_chain(PM_POST_SUSPEND);
+	suspend_diag("rollback-notifiers end\n");
  Restore:
+	suspend_diag("console-restore begin\n");
 	pm_restore_console();
+	suspend_diag("console-restore end\n");
 	return error;
 }

@@ -420,30 +477,42 @@
 {
 	int error;

+	suspend_diag("platform-prepare begin\n");
 	error = platform_suspend_prepare(state);
+	suspend_diag("platform-prepare end error=%d\n", error);
 	if (error)
 		goto Platform_finish;

+	suspend_diag("devices-late begin\n");
 	error = dpm_suspend_late(PMSG_SUSPEND);
+	suspend_diag("devices-late end error=%d\n", error);
 	if (error) {
 		pr_err("late suspend of devices failed\n");
 		goto Platform_finish;
 	}
+	suspend_diag("platform-prepare-late begin\n");
 	error = platform_suspend_prepare_late(state);
+	suspend_diag("platform-prepare-late end error=%d\n", error);
