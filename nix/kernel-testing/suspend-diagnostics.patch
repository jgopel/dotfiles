--- a/kernel/power/main.c
+++ b/kernel/power/main.c
@@ -153,6 +153,11 @@

 static BLOCKING_NOTIFIER_HEAD(pm_chain_head);

+bool pm_debug_notifier_chain(struct notifier_block **head)
+{
+	return head == &pm_chain_head.head && pm_debug_messages_on;
+}
+
