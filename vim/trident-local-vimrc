" C/C++ settings
autocmd BufRead,BufNewFile *.definition set filetype=cpp
autocmd BufRead,BufNewFile *.format set filetype=cpp
autocmd BufRead,BufNewFile *.graph set filetype=cpp
autocmd BufRead,BufNewFile *.protocol set filetype=cpp

autocmd BufRead,BufNewFile *.definition let b:ale_linters = {"cpp":[]}
autocmd BufRead,BufNewFile *.format let b:ale_linters = {"cpp":[]}
autocmd BufRead,BufNewFile *.graph let b:ale_linters = {"cpp":[]}
autocmd BufRead,BufNewFile *.protocol let b:ale_linters = {"cpp":[]}

" General use variables
let trident_build_dir = getcwd() . "/build"
let trident_llvm_bin_dir = trident_build_dir . "/llvm_path/bin"
let trident_clangd_path = trident_llvm_bin_dir . "/clangd"

" Cucumber settings
autocmd BufRead,BufNewFile *.feature set filetype=cucumber

" Configure ALE
let g:ale_c_clangformat_executable = trident_llvm_bin_dir . "/clang-format"
let g:ale_cmake_cmakelint_options = "--config=" . getcwd() . "/.cmakelintrc"
let g:ale_cpp_clangd_executable = trident_clangd_path
let g:ale_cpp_clangtidy_executable = trident_llvm_bin_dir . "/clang-tidy"

let g:ale_linters_explicit = 1
let g:ale_linters = {
\  "cmake": ["cmakelint"],
\  "cpp": ["clangd", "clangtidy"],
\  "python": ["flake8"],
\}

let g:ale_fixers = {
\  "cmake": ["cmakeformat"],
\  "cpp": ["clangtidy", "clang-format"],
\  "python": ["isort", "black"],
\}

" Configure YCM
let g:ycm_use_clangd = 1
let g:ycm_clangd_binary_path = trident_clangd_path
