" Tab settings
set expandtab
set tabstop=8
set shiftwidth=2
set softtabstop=0

au FileType python setlocal shiftwidth=4

" C/C++ settings
au BufRead,BufNewFile *.definition set filetype=cpp
au BufRead,BufNewFile *.format set filetype=cpp
au BufRead,BufNewFile *.graph set filetype=cpp
au BufRead,BufNewFile *.protocol set filetype=cpp

au BufRead,BufNewFile *.definition :ALEDisableBuffer
au BufRead,BufNewFile *.format :ALEDisableBuffer
au BufRead,BufNewFile *.graph :ALEDisableBuffer
au BufRead,BufNewFile *.protocol :ALEDisableBuffer

" General use variables
let trident_build_dir = getcwd() . "/path-to-build-dir"
let trident_llvm_bin_dir = trident_build_dir . "/llvm_path/bin"
let trident_clangd_path = trident_llvm_bin_dir . "/clangd"

" Cucumber settings
au BufRead,BufNewFile *.feature set filetype=cucumber

" Configure ALE
let g:ale_c_clangformat_executable = trident_llvm_bin_dir . "/clang-format"
let g:ale_cmake_cmakelint_options = "--config=" . getcwd() . "/.cmakelintrc"
let g:ale_cpp_clangd_executable = trident_clangd_path
let g:ale_cpp_clangtidy_executable = trident_llvm_bin_dir . "/clang-tidy"

let g:ale_linters_explicit = 1
let g:ale_linters = {
\  "cmake": ["cmakelint"],
\  "cpp": ["clangd", "clangtidy"],
\  "python": ["flake8"],
\}

let g:ale_fixers = {
\  "cmake": ["cmakeformat"],
\  "cpp": ["clangtidy", "clang-format"],
\  "python": ["isort", "black"],
\}

" Configure YCM
let g:ycm_use_clangd = 1
let g:ycm_clangd_binary_path = trident_clangd_path

